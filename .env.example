# Database (zdalna produkcyjna)
DB_URL=jdbc:mysql://your-prod-db-host:3306/homeoffice?serverTimezone=Europe/Warsaw&useSSL=true&requireSSL=true
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-central-1
BUCKET_NAME=focik-home

# URLs
HOME_URL=http://localhost

# KSef (Polish e-invoicing)
KSEF_TOKEN=your_ksef_token

# OpenAI (optional)
OPENIA_API_KEY=your_openai_api_key
CLAUDE_API_KEY=your_claude_api_key

# Scheduling & Debug
SCHEDULER_CRON=0 0 8 * * FRI
DEBUG=false
