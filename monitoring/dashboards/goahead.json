{
  "uid": "homeoffice-goahead",
  "title": "HomeOffice - GoAhead (faktury, koszty, KSeF)",
  "tags": [
    "homeoffice",
    "goahead"
  ],
  "timezone": "Europe/Warsaw",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "Źródło danych",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "instance",
        "label": "Instancja",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(up{job=\"homeoffice\"}, instance)",
          "refId": "StandardVariableQuery",
          "qryType": 1
        },
        "definition": "label_values(up{job=\"homeoffice\"}, instance)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "Powiązane dashboardy",
      "tags": [
        "homeoffice"
      ],
      "asDropdown": true,
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "KSeF",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "KSeF: odrzucone logowania",
      "description": "Logowania do KSeF odrzucone w wybranym zakresie czasu (HTTP 401 albo status uwierzytelnienia >= 400). Większe od 0 = prawdopodobnie wygasł KSEF_TOKEN.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(increase(homeoffice_ksef_operations_seconds_count{operation=\"login\", outcome=~\"unauthorized|auth_rejected\", instance=~\"$instance\"}[$__range])) or vector(0)",
          "legendFormat": "odrzucone",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "stat",
      "title": "KSeF: odrzucone faktury",
      "description": "Faktury odrzucone przez KSeF w wybranym zakresie czasu (wg statusu sesji wysyłkowej). Sama operacja send_invoices może się udać, a KSeF i tak odrzucić część faktur.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(increase(homeoffice_ksef_invoices_total{result=\"rejected\", instance=~\"$instance\"}[$__range])) or vector(0)",
          "legendFormat": "odrzucone",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "bargauge",
      "title": "KSeF: operacje wg wyniku",
      "description": "login = pełne logowanie do KSeF (tokenem lub certyfikatem; nie liczy tokenu z cache). Wynik: success, unauthorized (401), auth_rejected (odrzucone uwierzytelnienie), error. Błąd logowania liczy się też w operacji, która go wywołała.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (operation, outcome) (increase(homeoffice_ksef_operations_seconds_count{instance=~\"$instance\"}[$__range]))",
          "legendFormat": "{{operation}} / {{outcome}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color"
      },
      "id": 4,
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "timeseries",
      "title": "KSeF: średni czas operacji",
      "description": "Luki = w tym okresie nie było takiej operacji.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (operation) (rate(homeoffice_ksef_operations_seconds_sum{instance=~\"$instance\"}[$__rate_interval])) / sum by (operation) (rate(homeoffice_ksef_operations_seconds_count{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{operation}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 5,
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "id": 6,
      "type": "row",
      "title": "Zadania w tle (KSeF, PDF, ZUS DRA)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Nieudane zadania",
      "description": "Zadania zakończone statusem FAILED albo PARTIAL w wybranym zakresie czasu.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum(increase(homeoffice_async_tasks_total{job_type=~\"KSEF_.*|PDF_GENERATE.*|ZUS_DRA_PREPARE\", status=~\"FAILED|PARTIAL\", instance=~\"$instance\"}[$__range])) or vector(0)",
          "legendFormat": "nieudane",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "id": 7,
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "bargauge",
      "title": "Zadania wg typu i wyniku (w wybranym zakresie)",
      "description": "KSEF_FETCH_COSTS, KSEF_IMPORT_INVOICES, KSEF_SEND, PDF_GENERATE, PDF_GENERATE_COST, ZUS_DRA_PREPARE. Pusto = w tym zakresie nie zakończyło się żadne zadanie.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (job_type, status) (increase(homeoffice_async_tasks_total{job_type=~\"KSEF_.*|PDF_GENERATE.*|ZUS_DRA_PREPARE\", instance=~\"$instance\"}[$__range]))",
          "legendFormat": "{{job_type}} / {{status}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color"
      },
      "id": 8,
      "gridPos": {
        "x": 6,
        "y": 10,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "bargauge",
      "title": "Zadania: średni czas trwania",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (job_type) (increase(homeoffice_async_tasks_duration_seconds_sum{job_type=~\"KSEF_.*|PDF_GENERATE.*|ZUS_DRA_PREPARE\", instance=~\"$instance\"}[$__range])) / sum by (job_type) (increase(homeoffice_async_tasks_duration_seconds_count{job_type=~\"KSEF_.*|PDF_GENERATE.*|ZUS_DRA_PREPARE\", instance=~\"$instance\"}[$__range]))",
          "legendFormat": "{{job_type}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color"
      },
      "id": 9,
      "gridPos": {
        "x": 15,
        "y": 10,
        "w": 9,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Ruch HTTP: /api/goahead",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Żądania wg endpointu",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "topk(8, sum by (uri) (rate(http_server_requests_seconds_count{instance=~\"$instance\", uri=~\"/api/goahead.*\"}[$__rate_interval])))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "timeseries",
      "title": "Odpowiedzi wg statusu",
      "description": "4xx i 5xx z endpointów faktur, kosztów, kontrahentów.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{instance=~\"$instance\", uri=~\"/api/goahead.*\"}[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "timeseries",
      "title": "Odsetek błędów 5xx",
      "description": "0% = brak błędów 5xx. Luki = brak ruchu w danym okresie.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "(sum by (instance) (rate(http_server_requests_seconds_count{status=~\"5..\", instance=~\"$instance\", uri=~\"/api/goahead.*\"}[$__rate_interval])) or sum by (instance) (rate(http_server_requests_seconds_count{instance=~\"$instance\", uri=~\"/api/goahead.*\"}[$__rate_interval])) * 0) / sum by (instance) (rate(http_server_requests_seconds_count{instance=~\"$instance\", uri=~\"/api/goahead.*\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13,
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "timeseries",
      "title": "Endpointy wg łącznego czasu obsługi",
      "description": "Sekundy obsługi na sekundę: które endpointy GoAhead najbardziej obciążają backend.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "topk(8, sum by (uri) (rate(http_server_requests_seconds_sum{instance=~\"$instance\", uri=~\"/api/goahead.*\"}[$__rate_interval])))",
          "legendFormat": "{{uri}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    },
    {
      "type": "timeseries",
      "title": "Średni czas odpowiedzi",
      "description": "",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (instance) (rate(http_server_requests_seconds_sum{instance=~\"$instance\", uri=~\"/api/goahead.*\"}[$__rate_interval])) / sum by (instance) (rate(http_server_requests_seconds_count{instance=~\"$instance\", uri=~\"/api/goahead.*\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 15,
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      }
    }
  ]
}