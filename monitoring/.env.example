# Skopiuj do .env (nie jest commitowany) i uzupelnij na kazdym hoscie.

# synology albo ec2 - ta sama wartosc co APP_INSTANCE backendu na tym hoscie
APP_INSTANCE=synology

# Grafana Cloud -> Connections -> Hosted Prometheus metrics -> Details
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-65-prod-eu-west-2.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=3683945
# Access Policy z uprawnieniem metrics:write (Administration -> Access policies -> Add token)
GRAFANA_CLOUD_API_TOKEN=

# Ta sama wartosc co INTERNAL_API_TOKEN backendu
INTERNAL_API_TOKEN=
